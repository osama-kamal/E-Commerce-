# ── Frontend Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# All variables MUST be prefixed with VITE_ to be exposed to the browser.

# ── Store identity (required for multi-tenant API routing) ────────────────────
# Set to the MongoDB ObjectId of the store this frontend instance represents.
# You get this after your first onboarding (it's logged on /start page submit).
VITE_STORE_ID=your-24-char-mongodb-objectid

# Optional: use a human-readable slug instead of the ObjectId
# VITE_STORE_SLUG=my-store-slug

# ── Stripe (public key — safe to expose) ─────────────────────────────────────
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ── API URL (only needed for local dev; production uses Vercel rewrites) ──────
# VITE_API_URL=http://localhost:5000
