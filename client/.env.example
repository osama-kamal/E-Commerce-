# ── Frontend Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
#
# Only variables prefixed with VITE_ are exposed to the browser, and Vite inlines
# them at BUILD time — not at runtime. Changing a value requires a rebuild, and
# for Docker they must be passed as build args (see client/Dockerfile).
#
# Anything here ends up in the shipped JavaScript bundle. Never put a secret in
# this file — publishable/public identifiers only.
#
# This template lists every VITE_ variable the codebase actually reads. Verified
# consumers are named next to each one.

# ── Store identity (required for multi-tenant API routing) ────────────────────
# The MongoDB ObjectId of the store this frontend instance represents.
# You get this after your first onboarding (it is logged on /start page submit).
#
# MUST be a valid 24-character hex ObjectId. src/api/axios.ts validates it with
# /^[a-f\d]{24}$/i and refuses to send the X-Store-ID header if it does not
# match — every tenant API route then returns 404.
#
# Resolution order in the app (src/api/axios.ts, src/store/storeSlice.ts):
#   1. sessionStorage 'sf_active_slug'  — inside a /s/:slug storefront
#   2. localStorage 'currentStoreId'
#   3. the storeId claim on the access token
#   4. VITE_STORE_ID          ← this variable (fallback)
#   5. VITE_STORE_SLUG        ← last resort
#
# Read by: src/api/axios.ts, src/api/stores.ts, src/store/storeSlice.ts
VITE_STORE_ID=

# Optional human-readable slug, sent as the X-Store-Slug header when no valid
# store ID is available. Note that client/Dockerfile does NOT define a build arg
# for this one, so it cannot be set for a Docker image build as things stand.
#
# Read by: src/api/axios.ts
# VITE_STORE_SLUG=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Stripe PUBLISHABLE key (pk_test_… or pk_live_…). Safe to expose — never put the
# secret key (sk_…) here.
#
# src/utils/checkoutMode.ts treats a key as usable only when it starts with
# 'pk_', is longer than 30 characters, and does not contain '000000000000'.
# When the key is missing or unusable:
#   • development build → checkout offers a SIMULATED payment
#   • production build  → checkout REFUSES card payment (no bypass is rendered)
#
# Read by: src/pages/CheckoutPage.tsx (via src/utils/checkoutMode.ts)
VITE_STRIPE_PUBLISHABLE_KEY=

# ── API URL ───────────────────────────────────────────────────────────────────
# Target for the Vite dev-server proxy for /api and /uploads.
# Defaults to http://localhost:5000 when unset.
#
# Only needed for local development and Docker builds. In production the Vercel
# rewrite in client/vercel.json forwards /api to the backend instead, and the
# nginx image proxies /api to the backend service.
#
# Read by: vite.config.ts (loadEnv), client/Dockerfile (build arg)
# VITE_API_URL=http://localhost:5000
