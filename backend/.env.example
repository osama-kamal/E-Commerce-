# ── Backend Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env — it is in .gitignore.

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # change to "production" on your host

# ── Database ──────────────────────────────────────────────────────────────────
# Local:
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
# Atlas production (uncomment and fill in):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use long, random strings (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Generate at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email ─────────────────────────────────────────────────────────────────────
# Resend is the primary email provider (resend.com — generous free tier, no SMTP issues).
# Obtain API key from: https://resend.com → API Keys
RESEND_API_KEY=re_...
# Must be a verified sender in your Resend account (verify your domain or use onboarding@resend.dev for testing)
EMAIL_FROM_ADDRESS=orders@yourdomain.com
EMAIL_FROM_NAME=My Store
# Optional: receive a BCC copy of every order confirmation (admin notification)
ADMIN_BCC_EMAIL=admin@yourdomain.com

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Backend public URL (required for Paymob webhook callback_url) ─────────────
# Local dev:  use your ngrok URL, e.g. https://abc.ngrok-free.dev
# Production: your Railway domain, e.g. https://my-app.up.railway.app
BACKEND_URL=http://localhost:5000
