# ── Backend Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env — it is in .gitignore.
#
# This template mirrors the Zod schema in src/config/index.ts, which is the
# authoritative list. Validation runs at startup: a schema failure prints the
# offending keys and exits the process.
#
# ⚠️  IMPORTANT — do not "blank out" a variable by leaving it as `KEY=`.
#     An empty value is a PRESENT value, so the schema default does NOT apply:
#       MONGODB_URI=        → fails validation, server exits
#       ADMIN_NOTIFY_EMAIL= → fails validation ("Invalid email"), server exits
#       PORT=               → parses to NaN, server binds an arbitrary port
#     To use a default, leave the line COMMENTED OUT or delete it entirely.
#     That is why every variable with a working default is commented out below.


# ══════════════════════════════════════════════════════════════════════════════
# CORE
# ══════════════════════════════════════════════════════════════════════════════

# HTTP port. Default: 5000
# PORT=5000

# development | production | test. Default: development
# In production, JWT_ACCESS_SECRET and JWT_REFRESH_SECRET become REQUIRED and
# the development fallbacks are unavailable.
# NODE_ENV=development


# ══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════════════════════════════════════

# Default: mongodb://localhost:27017/ecommerce (logs a warning when it falls back)
#
# MUST point at a REPLICA SET. Checkout runs inside session.withTransaction(),
# which requires one; against a standalone mongod the code silently takes the
# non-transactional fallback path. docker-compose.yml runs a single-node replica
# set for exactly this reason.
#
# Local (single-node replica set, as started by docker compose):
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce?replicaSet=rs0&directConnection=true
#
# Atlas production (uncomment and fill in):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Legacy alias. When set, it OVERRIDES MONGODB_URI (src/config/index.ts resolves
# it after parsing). Prefer MONGODB_URI above; only set this if an existing
# deployment already depends on the old name.
# MONGO_URI=


# ══════════════════════════════════════════════════════════════════════════════
# REDIS (optional)
# ══════════════════════════════════════════════════════════════════════════════

# Default: redis://localhost:6379
# The server starts normally when Redis is unreachable — it retries twice, then
# marks Redis unavailable and continues.
#
# NOTE: Redis is currently WRITE-ONLY. src/modules/auth/auth.service.ts mirrors
# refresh-token hashes into Redis on login and deletes them on logout, but no
# code path ever reads them back — MongoDB is the sole source of truth for
# validating a refresh token. Setting this today buys no functional benefit.
# REDIS_URL=redis://localhost:6379


# ══════════════════════════════════════════════════════════════════════════════
# JWT / AUTH
# ══════════════════════════════════════════════════════════════════════════════

# REQUIRED in production. Minimum 32 characters each — shorter values fail
# validation and the server exits. Use long random strings, and use DIFFERENT
# values for the two secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The placeholders below are long enough to pass validation in development.
# They are NOT secrets — replace them before deploying anywhere.
JWT_ACCESS_SECRET=replace-me-with-a-random-64-hex-string-at-least-32-chars-long
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-random-64-hex-string-min-32-chars

# Access-token lifetime. Default: 15m
# JWT_ACCESS_EXPIRY=15m


# ══════════════════════════════════════════════════════════════════════════════
# CORS
# ══════════════════════════════════════════════════════════════════════════════

# Comma-separated allow-list; each entry is trimmed.
# Default: http://localhost:3000,http://localhost:5173
# Use http://localhost:8080 when running the client via docker compose.
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080


# ══════════════════════════════════════════════════════════════════════════════
# URLs
# ══════════════════════════════════════════════════════════════════════════════

# Used to build links inside transactional emails. Default: http://localhost:5173
# FRONTEND_URL=http://localhost:5173

# Public URL of THIS backend. Used as the Paymob webhook callback_url.
# Default: http://localhost:5000
# Local dev:  an ngrok URL, e.g. https://abc.ngrok-free.dev
# Production: your deployed API domain
# BACKEND_URL=http://localhost:5000


# ══════════════════════════════════════════════════════════════════════════════
# STRIPE
# ══════════════════════════════════════════════════════════════════════════════

# EFFECTIVELY REQUIRED. The Zod schema marks this optional, but
# src/config/stripe.ts throws at import time when it is missing, and that module
# is on the startup path — so the API will not boot without a value here.
# CI and docker-compose both supply a throwaway placeholder for this reason.
STRIPE_SECRET_KEY=sk_test_replace_me

# Needed to verify Stripe webhook signatures (Stripe Dashboard → Webhooks).
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe Price IDs, mapped to internal subscription plans by buildPriceMap() in
# src/config/planLimits.ts. Subscription billing for a plan is inactive until
# its Price ID is set. The 'free' plan has no Price ID by design.
# STRIPE_PRICE_STARTER=price_replace_me
# STRIPE_PRICE_PRO=price_replace_me
# STRIPE_PRICE_ENTERPRISE=price_replace_me


# ══════════════════════════════════════════════════════════════════════════════
# PAYMOB (MENA payment gateway — optional)
# ══════════════════════════════════════════════════════════════════════════════

# Paymob Dashboard → Settings → Account Info / API Keys.
# Consumed by src/modules/payments/providers/paymob.adapter.ts.

# Required for Paymob. Throws "PAYMOB_API_KEY is not configured" when missing.
# PAYMOB_API_KEY=

# Required for Paymob. Card-payment integration ID, used to generate the payment
# key. Throws "PAYMOB_INTEGRATION_ID_CARD is not configured" when missing.
# PAYMOB_INTEGRATION_ID_CARD=

# Required for Paymob. HMAC-SHA512 secret used to verify webhook callbacks
# (Paymob Dashboard → Developers → HMAC Secret).
# PAYMOB_HMAC_SECRET=

# Hosted iframe ID (Paymob Dashboard → Developers → Iframes).
# This is DIFFERENT from the integration ID above. When unset, the adapter falls
# back to PAYMOB_INTEGRATION_ID_CARD, which usually produces a broken iframe URL.
# PAYMOB_IFRAME_ID=


# ══════════════════════════════════════════════════════════════════════════════
# EMAIL — Resend
# ══════════════════════════════════════════════════════════════════════════════

# Obtain from https://resend.com → API Keys.
# Without it the email service logs a warning and silently disables sending.
# RESEND_API_KEY=re_replace_me

# Must be a verified sender in your Resend account (verify your domain, or use
# onboarding@resend.dev for testing). Default when unset: onboarding@resend.dev
# EMAIL_FROM_ADDRESS=orders@yourdomain.com

# Sender display name. Default: Ecommerce Store
# EMAIL_FROM_NAME=My Store

# Optional — receive a BCC copy of every order confirmation.
# ADMIN_BCC_EMAIL=admin@yourdomain.com

# Where enterprise sales enquiries (/support/contact-sales) and plan-upgrade
# requests are emailed. There is NO fallback: when unset the enquiry is recorded
# in the logs and no email is sent. A hardcoded personal address used to be the
# fallback, which silently forwarded a new deployment's sales leads to the
# original author's inbox.
#
# Must be a valid email address — an empty value fails validation and the server
# will not start. Comment the line out instead of blanking it.
# ADMIN_NOTIFY_EMAIL=you@yourcompany.com


# ══════════════════════════════════════════════════════════════════════════════
# CLOUDINARY (image hosting — optional)
# ══════════════════════════════════════════════════════════════════════════════

# Product and store-logo uploads are streamed straight to Cloudinary.
# Uploads fail without these.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=


# ══════════════════════════════════════════════════════════════════════════════
# SENTRY — error tracking (optional locally, REQUIRED in production)
# ══════════════════════════════════════════════════════════════════════════════
#
# Leave SENTRY_DSN unset and the SDK is never initialised — every Sentry call
# becomes a no-op, so local development and CI are untouched. That is also how
# you would deploy with no crash reporting at all, so the server logs a loud
# warning on boot if NODE_ENV=production and this is missing.
#
# Only 5xx responses are reported. Request bodies, query strings and credential
# headers are stripped before anything leaves the process — see
# src/config/sentry.ts. Get the DSN from sentry.io → Project → Settings → SDK Setup.
# SENTRY_DSN=

# Groups issues by deploy so a regression can be tied to what shipped.
# On Railway set this to ${{RAILWAY_GIT_COMMIT_SHA}}.
# SENTRY_RELEASE=

# Fraction of requests traced for performance data, 0–1. Defaults to 0 —
# tracing is billed per transaction and is not needed for error tracking.
# SENTRY_TRACES_SAMPLE_RATE=0


# ══════════════════════════════════════════════════════════════════════════════
# AI / CHATBOT (optional)
# ══════════════════════════════════════════════════════════════════════════════

# Generate at https://platform.openai.com/api-keys
# Must start with "sk-" or "sk-proj-" to be accepted; anything else (and any
# failed API call) falls back to the rule-based responder in
# src/modules/chatbot/chatbot.service.ts.
# OPENAI_API_KEY=sk-proj-replace_me

# Chat completion model. Default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini


# ══════════════════════════════════════════════════════════════════════════════
# BEHAVIOUR FLAGS
# ══════════════════════════════════════════════════════════════════════════════

# Minutes before an abandoned ONLINE checkout is cancelled and its stock
# released. Default: 30
# placeOrder decrements stock before payment, so without this an abandoned
# checkout would hold inventory forever. A sweep runs every 5 minutes.
# Cash-on-delivery orders are never expired.
# PENDING_ORDER_TTL_MINUTES=30

# Verified-purchase enforcement: a customer may only review a product they have
# a DELIVERED order for. Enabled by default — leave this unset in production.
# Set to "true" ONLY for demo/seeding environments that need reviews without
# real orders. This used to be inferred from NODE_ENV, which meant an unset
# NODE_ENV silently let anyone review anything.
# ALLOW_UNVERIFIED_REVIEWS=false


# ══════════════════════════════════════════════════════════════════════════════
# DECLARED IN THE SCHEMA BUT NOT CONSUMED BY ANY CODE PATH
# ══════════════════════════════════════════════════════════════════════════════
#
# These are still parsed and exported by src/config/index.ts, and some of them
# appear in the startup "optional env vars not set" warning, but nothing in the
# application reads them. Setting them has NO effect. They are listed here only
# so you do not waste time hunting for values — removing them requires a change
# to src/config/index.ts, not to this file.
#
#   EMAIL_HOST, EMAIL_PORT, EMAIL_SECURE, EMAIL_USER, EMAIL_PASS
#       Legacy SMTP settings from before the move to Resend. `nodemailer` is not
#       even a dependency any more; src/services/email.service.ts uses the
#       Resend SDK exclusively. EMAIL_USER still triggers a startup warning.
#
#   PAYMOB_SECRET_KEY
#       Documented in the adapter header and warned about at startup, but never
#       read. Paymob callback verification uses PAYMOB_HMAC_SECRET.
#
#   PAYMOB_INTEGRATION_ID_WALLET
#       Referenced only in a code comment. Mobile-wallet payments are not wired
#       up; only the card integration is.


# ══════════════════════════════════════════════════════════════════════════════
# MAINTENANCE SCRIPTS (not server configuration)
# ══════════════════════════════════════════════════════════════════════════════
#
# src/scripts/reset-password.ts reads these when they are not passed as CLI
# arguments. Prefer passing them on the command line so a password never has to
# be written to disk:
#
#   npx ts-node src/scripts/reset-password.ts <email> <new-password>
#
# RESET_EMAIL=
# RESET_PASSWORD=
