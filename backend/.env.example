# ── Backend Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env — it is in .gitignore.

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # change to "production" on your host

# ── Database ──────────────────────────────────────────────────────────────────
# Local:
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
# Atlas production (uncomment and fill in):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use long, random strings (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Generate at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password   # App password, not your real password
EMAIL_FROM_NAME=My Store

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
