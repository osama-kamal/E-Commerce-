{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "E-Commerce Platform Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/seed.ts",
    "update-images": "ts-node src/update-images.ts",
    "create-indexes": "ts-node src/scripts/create-indexes.ts",
    "migrate:payment-intent-index": "ts-node src/scripts/drop-payment-intent-unique-index.ts",
    "migrate:order-idempotency-index": "ts-node src/scripts/fix-order-idempotency-index.ts",
    "migrate:store-theme": "ts-node src/scripts/backfill-store-theme.ts",
    "migrate:trial-ends-at": "ts-node src/scripts/backfill-trial-ends-at.ts",
    "migrate:order-totals": "ts-node src/scripts/backfill-order-totals.ts",
    "migrate:payment-status": "ts-node src/scripts/backfill-payment-status.ts",
    "report:identity-collisions": "ts-node src/scripts/report-identity-collisions.ts",
    "verify:restore": "ts-node src/scripts/verify-restore.ts",
    "repair:owners": "ts-node src/scripts/consolidate-duplicate-owners.ts",
    "repair:store-owner": "ts-node src/scripts/repair-orphaned-store-owner.ts",
    "optimize-images": "ts-node src/scripts/optimize-existing-images.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "@types/cookie-parser": "1.4.10",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "csv-stringify": "^6.7.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "resend": "6.12.4",
    "sharp": "^0.35.3",
    "stripe": "^14.10.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/node-cache": "^4.1.3",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.56.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
